{"name":"GIGWIRE — live music gigs across India","short_name":"GIGWIRE","description":"India's handmade gig board. Bars, cafés and taprooms post live music vacancies with the pay stated up front. Musicians apply with a one-sheet and get paid on the night. No agents, no commission.","start_url":"/Gigwire/","scope":"/Gigwire/","display":"standalone","orientation":"portrait-primary","background_color":"#f1e4cd","theme_color":"#171310","lang":"en-IN","dir":"ltr","categories":["music","entertainment","business"],"icons":[{"src":"/Gigwire/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/Gigwire/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/Gigwire/icon-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"},{"src":"/Gigwire/icon.svg","sizes":"any","type":"image/svg+xml"}],"shortcuts":[{"name":"The gig board","short_name":"Gigs","description":"Every open night on the wire","url":"/Gigwire/gigs/","icons":[{"src":"/Gigwire/icon-192.png","sizes":"192x192"}]},{"name":"Post a night","short_name":"Post","description":"Write a flyer for your room","url":"/Gigwire/post/","icons":[{"src":"/Gigwire/icon-192.png","sizes":"192x192"}]}]}